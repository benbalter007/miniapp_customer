<view class="tab-bar">
  <view
    class="tab-bar__item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <app-icon
      name="{{item.iconType}}"
      size="20"
      color="{{color}}"
      activeColor="{{selectedColor}}"
      active="{{selected === index}}"
      tone="soft"
      padding="10rpx"
      class="tab-bar__icon"
    />
    <text class="tab-bar__text {{selected === index ? 'tab-bar__text--active' : ''}}">{{item.text}}</text>
  </view>
</view>

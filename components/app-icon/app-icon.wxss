.app-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.app-icon--block {
  width: 100%;
  height: 100%;
}

.app-icon--soft {
  background: rgba(1, 119, 129, 0.08);
}

.app-icon--solid {
  background: rgba(1, 119, 129, 0.12);
}

.app-icon--active {
  transform: scale(1.02);
}
<view class="profile-grid">
  <view
    class="profile-grid__item"
    wx:for="{{items}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-label="{{item.label}}"
    bindtap="onItemTap"
  >
    <view class="profile-grid__icon-wrap">
      <app-icon
        name="{{item.iconType}}"
        size="18"
        color="#017781"
        activeColor="#017781"
        tone="soft"
        padding="14rpx"
      />
    </view>
    <text class="profile-grid__label">{{item.label}}</text>
  </view>
</view>
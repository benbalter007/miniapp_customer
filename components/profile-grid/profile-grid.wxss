.profile-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx 12rpx;
}

.profile-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 148rpx;
  padding: 18rpx 8rpx;
  border-radius: var(--radius-cover);
  background: var(--color-primary-soft);
}

.profile-grid__icon-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--color-primary-focus-ring);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-grid__label {
  font-size: var(--font-tiny);
  line-height: 1.3;
  color: var(--color-text-secondary);
  text-align: center;
}
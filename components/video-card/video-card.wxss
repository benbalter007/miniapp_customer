.video-card {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-card-inner);
  margin-bottom: var(--spacing-list-gap);
  box-shadow: var(--shadow-card);
}

.video-card:active {
  opacity: 0.92;
}

.video-card__cover-wrap {
  position: relative;
  width: 220rpx;
  height: 150rpx;
  border-radius: var(--radius-cover);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface);
}

.video-card__cover {
  width: 100%;
  height: 100%;
}

.video-card__cover--placeholder {
  background: linear-gradient(135deg, #d7f0f4, #a8d8e0);
}

.video-card__cover--teal {
  background: linear-gradient(135deg, #d7f0f4, #80bbc1);
}

.video-card__cover--mint {
  background: linear-gradient(135deg, #c8ebe8, #7ec4bc);
}

.video-card__cover--sand {
  background: linear-gradient(135deg, #f5e6d0, #e8c9a0);
}

.video-card__play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.video-card__play-triangle {
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 20rpx solid var(--color-primary);
  margin-left: 4rpx;
}

.video-card__duration-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #ffffff;
  font-size: var(--font-tiny);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.video-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-left: var(--spacing-card-inner);
  min-width: 0;
}

.video-card__title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.video-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--spacing-small);
}

.video-card__author {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.video-card__meta-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-medium);
}

.video-card__views {
  font-size: var(--font-small);
  color: var(--color-text-hint);
}

.video-card__bookmark {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.video-card__bookmark-shape {
  width: 24rpx;
  height: 30rpx;
  border: 3rpx solid var(--color-text-disabled);
  border-radius: 4rpx 4rpx 0 0;
  position: relative;
}

.video-card__bookmark-shape::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid var(--color-text-disabled);
}

.video-card__bookmark--active .video-card__bookmark-shape {
  border-color: var(--color-accent);
  background: var(--color-accent);
}

.video-card__bookmark--active .video-card__bookmark-shape::after {
  border-top-color: var(--color-accent);
}
